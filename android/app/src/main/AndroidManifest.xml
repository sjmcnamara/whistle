<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.NFC" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".FindMyFamApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FindMyFam">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.FindMyFam">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Deep link for whistle:// invite URLs -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="whistle" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".services.MotionTransitionReceiver"
            android:exported="false" />

        <!-- System broadcast — must be exported=true or BOOT_COMPLETED never
             reaches it, despite being a protected broadcast only the system
             can send. Restarts location sharing after a reboot; see
             BootCompletedReceiver for why this exists and what it does and
             does not check before acting. -->
        <receiver
            android:name=".services.BootCompletedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Keeps location sharing alive while the app is closed — see
             WhistleForegroundService for why this exists. Started/stopped by
             AppViewModel and BootCompletedReceiver, never launched directly
             by the user.

             Type is dataSync, not location, despite what this Service is
             for — confirmed live on a real reboot cycle: Android disallows a
             location/camera/microphone-typed FGS from being started from a
             background context (a BroadcastReceiver, here) even within
             BOOT_COMPLETED's temporary background-start allowlist, throwing
             SecurityException the instant startForeground() is called. Only
             LocationService itself calls the location APIs directly, and it
             is a plain Hilt singleton with no FGS type of its own — this
             Service's only job is holding startForeground() to keep the
             process alive, which dataSync (relay/MLS/location payload sync)
             describes just as accurately without hitting that restriction. -->
        <service
            android:name=".services.WhistleForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Shares diagnostics reports as a file. Grants read access to a
             single cache file per share rather than exposing app storage. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
