*.xcodeproj/
*.xcworkspace/
xcuserdata/
DerivedData/
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3

# CI-only vendor clones
vendor/

# macOS
.DS_Store

# Build (iOS)
DerivedData/

# Build (Android)
android/app/build/
android/shared/build/
android/build/
android/.gradle/

# Swift Package Manager build artifacts
FindMyFamCore/.build/
.build/

# JetBrains IDE (root and any module)
.idea/

# Android
android/.gradle/
android/app/build/
android/local.properties
*.apk
*.aab
*.iml

# Android native libs — checked in because MDK Kotlin bindings
# require Rust cross-compilation to rebuild. See android/BUILD.md.
!android/app/src/main/jniLibs/**/*.so
# MkDocs build output
website/site/

# Claude Code — local settings stay out, shared skills are checked in
.claude/*
!.claude/skills/

# Editor swap files
*.swp
*.swo
*~
