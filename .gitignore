# Xcode — generated by XcodeGen, not committed
*.xcodeproj/
*.xcworkspace/
xcuserdata/
DerivedData/
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3

# CI-only vendor clones
vendor/

# macOS
.DS_Store

# Build (iOS)
DerivedData/

# Build (Android)
android/app/build/
android/shared/build/
android/build/
android/.gradle/

# Swift Package Manager build artifacts
FindMyFamCore/.build/
.build/

# JetBrains IDE (root and any module)
.idea/

# Android
android/.gradle/
android/app/build/
android/local.properties
*.apk
*.aab
*.iml

# Android native libs — checked in because MDK Kotlin bindings
# require Rust cross-compilation to rebuild. See android/BUILD.md.
!android/app/src/main/jniLibs/**/*.so
# MkDocs build output
website/site/

# Claude Code — local settings stay out, shared skills are checked in
.claude/*
!.claude/skills/

# Editor swap files
*.swp
*.swo
*~

# Apple signing / App Store Connect API-key material — generated locally per
# the ios-release skill, then base64'd into repo secrets. Never belongs in
# the working tree longer than it takes to do that, let alone committed.
*.p12
*.p8
*.cer
*.pem
*.key
*.mobileprovision
*.certSigningRequest

# build.sh concurrency lock (see scripts/build.sh)
.build-lock/

# MarmotKit's Android native library is vendored by
# scripts/vendor_marmotkit_android.py, not committed: it is 51.8MB for arm64
# alone (already stripped), against MDK's 15.6MB. Committing it would add that
# to the repository on every version bump. The generated Kotlin bindings *are*
# committed — they are reviewable source, same as MarmotKit.swift on iOS.
android/app/src/main/jniLibs/arm64-v8a/libmarmot_uniffi.so
